# 默认按文本处理，入库统一 LF
* text=auto eol=lf

# Shell 脚本必须 LF，否则 Linux/NAS 上执行会报 "$'\r': command not found"
*.sh      text eol=lf
install.sh text eol=lf

# PowerShell 用 CRLF（兼容 Windows PowerShell 5.1）
*.ps1     text eol=crlf

# Python / JSON / Markdown 统一 LF
*.py      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.ico     binary
*.zip     binary
